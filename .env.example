# UniRed Backend environment template

# Supabase DB password
DB_PASSWORD=replace_with_your_db_password

# Base64 secret for JWT (recommended: 64 random bytes encoded in Base64)
JWT_SECRET=replace_with_base64_secret

# Firebase (optional in local)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# Gmail SMTP (REQUIRED for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tuemail@gmail.com
SMTP_PASSWORD=app_password_de_16_caracteres

# Resend (REQUIRED for email verification; SMTP_* vars are no longer used). Get the key at resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=UniRed <onboarding@resend.dev>
# Redirige TODOS los codigos a esta direccion (util mientras Resend no tenga dominio verificado).
# Vacio = cada codigo va al correo real del usuario.
RESEND_REDIRECT_TO=

# Envio de correos. smtp = Gmail (recomendado), resend = API de Resend.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=unired.uniminuto@gmail.com
SMTP_PASSWORD=clave_de_aplicacion_de_16_caracteres

# Brevo: API HTTPS, es la via que funciona en hostings que bloquean SMTP (Render).
# Requiere desactivar la restriccion por IP en app.brevo.com/security/authorised_ips
BREVO_API_KEY=
BREVO_FROM_EMAIL=unired.uniminuto@gmail.com
